{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gg.local/schemas/verdict.schema.json",
  "type": "object",
  "required": ["schema_version", "id", "claim_id", "claim_revision", "evidence_ids", "scope", "verdict", "confidence", "reviewed_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string"},
    "claim_id": {"type": "string"},
    "claim_revision": {"type": "integer", "minimum": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "scope": {"type": "object"},
    "verdict": {"enum": ["static-supported", "static-contradicted", "runtime-supported", "runtime-contradicted", "partial", "unknown", "requires-runtime-evidence", "disputed"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reviewed_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
