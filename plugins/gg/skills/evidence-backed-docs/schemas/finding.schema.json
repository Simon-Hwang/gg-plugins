{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gg.local/schemas/finding.schema.json",
  "type": "object",
  "required": ["schema_version", "id", "fingerprint", "type", "severity", "status", "timing", "overdue"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string"},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "type": {"type": "string"},
    "severity": {"enum": ["critical", "high", "medium", "low"]},
    "status": {"enum": ["open", "acknowledged", "fixing", "pending-validation", "resolved", "deferred", "rejected", "accepted-risk", "disputed", "reopened", "pending-review"]},
    "owner": {"type": ["string", "null"]},
    "overdue": {"type": "boolean"},
    "timing": {
      "type": "object",
      "required": ["created_at", "escalation_level"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "acknowledge_due_at": {"type": ["string", "null"], "format": "date-time"},
        "resolution_target_at": {"type": ["string", "null"], "format": "date-time"},
        "next_review_at": {"type": ["string", "null"], "format": "date-time"},
        "last_escalated_at": {"type": ["string", "null"], "format": "date-time"},
        "escalation_level": {"type": "integer", "minimum": 0}
      }
    }
  },
  "additionalProperties": true
}
