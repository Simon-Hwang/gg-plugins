{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gg.local/schemas/knowledge-registry.schema.json",
  "type": "object",
  "required": ["schema_version", "domains"],
  "properties": {
    "schema_version": {"const": "1"},
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain_id", "scope", "manifest", "manifest_hash", "intents", "terms", "verification_status", "updated_at"],
        "properties": {
          "domain_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "scope": {"type": "object"},
          "manifest": {"type": "string", "pattern": "^knowledge/domains/[^/]+/manifest\\.json$"},
          "manifest_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "intents": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "terms": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "verification_status": {"type": "string"},
          "updated_at": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
