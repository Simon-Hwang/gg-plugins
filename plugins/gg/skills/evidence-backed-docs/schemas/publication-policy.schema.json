{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gg.local/schemas/publication-policy.schema.json",
  "type": "object",
  "required": ["schema_version", "policy_id", "allowed_roots", "routes", "required_approvals", "allowed_verification_statuses", "finding_gates", "freshness_policy", "index_targets", "context_pack_route", "rollback_policy"],
  "properties": {
    "schema_version": {"const": "1"},
    "policy_id": {"type": "string", "minLength": 1},
    "allowed_roots": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target"],
        "properties": {
          "knowledge_id": {"type": "string", "minLength": 1},
          "match": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1}
        },
        "anyOf": [
          {"required": ["knowledge_id"]},
          {"required": ["match"]}
        ]
      }
    },
    "required_approvals": {"type": "array", "items": {"type": "string"}},
    "allowed_verification_statuses": {"type": "array", "items": {"type": "string"}},
    "finding_gates": {"type": "array"},
    "freshness_policy": {"type": "object"},
    "index_targets": {"type": "array", "items": {"type": "string"}},
    "context_pack_route": {
      "type": "object",
      "required": ["target", "mode"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "mode": {"const": "copy"}
      }
    },
    "rollback_policy": {
      "type": "object",
      "required": ["require_after_hash_match", "preserve_publication_record"],
      "properties": {
        "require_after_hash_match": {"const": true},
        "preserve_publication_record": {"const": true}
      }
    }
  },
  "additionalProperties": true
}
